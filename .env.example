# Local development configuration
# For deployment, these are set via Terraform / Secret Manager / agents-cli deploy.

# Gemini platform configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Strategic Model Routing overrides (optional)
FAST_MODEL=gemini-3.8-flash
PRO_MODEL=gemini-3.1-pro-preview

# Observability & Security controls
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=travel-concierge-agent
ENABLE_CLOUD_DLP=false
ENABLE_SECRET_MANAGER=false
# Set to true only on workstations requiring Enterprise Certificate / gcloud mTLS refresh:
USE_GCLOUD_CLI_CREDENTIALS=false
# MODEL_ARMOR_TEMPLATE_ID=projects/your-gcp-project-id/locations/us-central1/templates/travel-guardrail
# VERTEX_SEARCH_DATASTORE_ID=projects/your-gcp-project-id/locations/global/collections/default_collection/dataStores/travel-policies

# Alternatively, for Gemini API via Google AI Studio:
# GOOGLE_GENAI_USE_ENTERPRISE=false
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=your-api-key-here
